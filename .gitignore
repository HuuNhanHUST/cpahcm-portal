# Secrets — không bao giờ commit
.env
.env.*
!.env.example

# Dữ liệu thật trên server (bind mount uploads/uploads-private của container backend)
/data/

# Bản backup database/file cục bộ trên server (nên rsync sang nơi khác, không cần track trong Git)
/backups/

# Ghi nhớ tag image đang chạy để deploy.sh biết rollback về đâu khi cần
.deploy_state

# SSL certificates (Let's Encrypt) — sinh ra trên server, không phải source code
/nginx/certbot/

# OS
.DS_Store
Thumbs.db
