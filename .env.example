# ============================================================================
# Biến môi trường cho docker-compose.yml Ở GỐC REPO (KHÔNG phải backend/.env).
# Copy file này thành ".env" (cùng cấp, cạnh docker-compose.yml) rồi điền giá trị thật.
# KHÔNG BAO GIỜ commit file ".env" thật vào Git.
# ============================================================================

# ---- PostgreSQL (container "postgres") ----
# QUAN TRỌNG: 3 giá trị này PHẢI khớp CHÍNH XÁC với DATABASE_URL khai trong backend/.env
# (vd. POSTGRES_USER=cpa_admin, POSTGRES_PASSWORD=xxx, POSTGRES_DB=cpahcm_db thì
# backend/.env phải có DATABASE_URL="postgresql://cpa_admin:xxx@postgres:5432/cpahcm_db?schema=public")
# — 2 file .env này KHÔNG tự động đồng bộ với nhau, phải tự tay đảm bảo khớp.
POSTGRES_USER=cpa_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cpahcm_db

# ---- Container Registry (nơi CI đẩy Docker image lên, xem .github/workflows/cd.yml) ----
# LƯU Ý: tên image trên Docker registry BẮT BUỘC viết thường toàn bộ (kể cả khi username/tên
# repo GitHub có chữ hoa) — vd. GitHub "MyOrg/CPA-Portal" thì image phải là "myorg/cpa-portal-...".
BACKEND_IMAGE=ghcr.io/huunhanhust/cpahcm-portal-backend
FRONTEND_IMAGE=ghcr.io/huunhanhust/cpahcm-portal-frontend
# Tag image muốn deploy — pipeline CD sẽ tự set giá trị này (theo mã commit) khi chạy,
# để trống/để "local" khi build thủ công trên máy dev.
IMAGE_TAG=local

# ---- Frontend build-time ----
# Địa chỉ backend mà TRÌNH DUYỆT người dùng gọi tới — phải là domain/IP thật truy cập được
# từ Internet (không phải "backend" hay "localhost"), vì đây là JS chạy trên máy khách.
# Dùng CHUNG 1 domain với frontend (không cần subdomain "api." riêng) vì nginx.conf đã route
# theo path: "/api/*" và "/uploads/*" -> backend, còn lại -> frontend, cùng trên 1 domain.
NEXT_PUBLIC_API_BASE_URL=https://cpahcm.com.vn

# ---- Nginx / SSL (Let's Encrypt qua certbot) ----
DOMAIN=cpahcm.com.vn
# TODO: xác nhận đây là hộp mail thật có người theo dõi — Let's Encrypt gửi cảnh báo về đây
# khi chứng chỉ SSL sắp hết hạn (nếu certbot tự renew bị lỗi).
CERTBOT_EMAIL=admin@cpahcm.com.vn
