PORT=3001

# Database - PostgreSQL (Docker)
DATABASE_URL="postgresql://cpa_admin:CHANGE_ME@localhost:5432/cpahcm_db?schema=public"

# JWT Configuration — BẮT BUỘC, không có giá trị mặc định. Server sẽ không khởi động nếu thiếu.
# Dùng 3 secret RIÊNG BIỆT cho access / refresh / mfa-temp token (mỗi secret >= 32 ký tự random).
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_MFA_SECRET=
JWT_MFA_EXPIRES_IN=10m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail (SMTP) - dùng SendGrid SMTP relay: MAIL_USER luôn là literal "apikey", MAIL_PASS là SendGrid API key
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=
MAIL_FROM=noreply@cpahcm.com.vn

# OAuth - Google (Leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# OAuth - Facebook (Leave empty to disable)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/v1/auth/facebook/callback

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Throttle (Rate Limiting) - giới hạn CHUNG cho mọi API, không riêng đăng nhập. Xem giải thích chi
# tiết trong .env — 300/60s đủ rộng cho 1 lượt điều hướng thật (nhiều request/trang) mà vẫn chặn
# được scraping/DoS thô sơ. Endpoint auth nhạy cảm dùng AUTH_THROTTLE_* riêng bên dưới, nghiêm ngặt hơn.
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# Throttle riêng cho các endpoint auth nhạy cảm (login/forgot-password)
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=5

# Chatbot tư vấn (Gemini API) — KHÔNG bắt buộc để server khởi động (chỉ tính năng chat bị tắt
# nếu thiếu), tránh 1 endpoint phụ làm sập toàn bộ backend khi thiếu key. Lấy key tại
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Throttle riêng cho endpoint chat — mỗi request gọi Gemini API đều tốn phí (khi hết free tier),
# giới hạn chặt hơn throttle chung để tránh 1 client spam làm phát sinh chi phí lớn.
CHAT_THROTTLE_TTL=60000
CHAT_THROTTLE_LIMIT=15
